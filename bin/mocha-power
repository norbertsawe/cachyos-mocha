#!/usr/bin/env bash
set -euo pipefail
choice="$(printf 'Lock\nSuspend\nLog out\nReboot\nPower off\n' | rofi -dmenu -i -p Session)" || exit 0
case "$choice" in
    Lock) hyprlock ;;
    Suspend) hyprlock & sleep 1; systemctl suspend ;;
    'Log out'|Reboot|'Power off')
        confirm="$(printf 'Cancel\nConfirm\n' | rofi -dmenu -p "$choice?")" || exit 0
        [[ "$confirm" == Confirm ]] || exit 0
        case "$choice" in
            'Log out') hyprctl dispatch exit ;;
            Reboot) systemctl reboot ;;
            'Power off') systemctl poweroff ;;
        esac ;;
esac
