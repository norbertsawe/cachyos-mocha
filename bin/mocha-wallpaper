#!/usr/bin/env bash
set -euo pipefail
wallpaper_dir="${XDG_DATA_HOME:-$HOME/.local/share}/cachyos-mocha/wallpapers"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cachyos-mocha"
mkdir -p "$state_dir"
if ! awww query >/dev/null 2>&1; then
    awww-daemon >/dev/null 2>&1 &
    for ((i=0; i<50; i++)); do
        if awww query >/dev/null 2>&1; then break; fi
        sleep 0.1
    done
fi
if [[ "${1:-}" == --restore ]]; then
    wallpaper="$wallpaper_dir/catppuccin.png"
    if [[ -f "$state_dir/wallpaper" ]]; then IFS= read -r wallpaper < "$state_dir/wallpaper"; fi
    [[ -f "$wallpaper" ]] || wallpaper="$wallpaper_dir/catppuccin.png"
elif [[ $# -gt 0 ]]; then
    wallpaper="$(realpath -- "$1")"
else
    wallpaper="$( { find "$wallpaper_dir" "${XDG_PICTURES_DIR:-$HOME/Pictures}" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null || true; } | sort -u | rofi -dmenu -i -p Wallpaper)" || exit 0
fi
[[ -f "$wallpaper" ]] || exit 0
awww img "$wallpaper"
printf '%s\n' "$wallpaper" > "$state_dir/wallpaper"
