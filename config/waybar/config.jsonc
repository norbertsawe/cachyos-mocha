{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "height": 38,
  "exclusive": true,
  "passthrough": false,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "custom/applauncher",
    "hyprland/window",
    "clock"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "custom/pacman",
    "cpu",
    "custom/network",
    "pulseaudio",
    "battery",
    "custom/power"
  ],
  "custom/applauncher": {
    "format": "  Apps",
    "tooltip": false,
    "on-click": "rofi -show drun -show-icons",
    "on-click-right": "~/.local/bin/mocha-settings"
  },
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Mozilla Firefox": "$1"
    },
    "max-length": 25,
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "active": "◉",
      "default": "○"
    },
    "persistent-workspaces": {
      "*": 3
    }
  },
  "clock": {
    "tooltip": false,
    "interval": 60,
    "format": "{:%H:%M  |  %d %b}",
    "format-alt": "{:%A, %B %d, %Y}"
  },
  "custom/pacman": {
    "format": "󰮯",
    "tooltip": false,
    "on-click": "kitty -e bash -lc 'sudo pacman -Syu; read -n 1 -s -r'"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%"
  },
  "custom/network": {
    "exec": "bash -c 'if [ \"$(nmcli -t -f WIFI g)\" = \"disabled\" ]; then echo \"󰖪 off\"; else ssid=$(nmcli -t -f TYPE,STATE,CONNECTION dev status | grep \"^wifi:connected:\" | cut -d: -f3- | head -n1); if [ -n \"$ssid\" ] && [ \"$ssid\" != \"--\" ]; then echo \" $ssid\"; else echo \" on\"; fi; fi'",
    "interval": 3,
    "tooltip": false,
    "return-type": "text",
    "on-click": "bash -c 'if [ \"$(nmcli -t -f WIFI g)\" = \"enabled\" ]; then nmcli radio wifi off; else nmcli radio wifi on; fi'",
    "on-click-right": "nm-connection-editor"
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "battery": {
    "tooltip": false,
    "interval": 10,
    "format": "{icon} {capacity}%",
    "format-alt": "{time}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.local/bin/mocha-power"
  }
}
