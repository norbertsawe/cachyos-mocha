#!/usr/bin/env bash
set -euo pipefail
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=cachyos-mocha
export XDG_SESSION_TYPE=wayland
export BROWSER=firefox
export TERMINAL=kitty
export QT_QPA_PLATFORM='wayland;xcb'
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=kvantum
export ELECTRON_OZONE_PLATFORM_HINT=auto
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=30
export HYPRCURSOR_THEME=Bibata-Modern-Ice
export HYPRCURSOR_SIZE=30
mocha_config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
if [[ ! -f "$mocha_config" ]]; then
    printf 'CachyOS Mocha is not installed for %s. Run install.sh as this user first.\n' "$USER" >&2
    exit 1
fi
exec /usr/bin/start-hyprland -- --config "$mocha_config"
